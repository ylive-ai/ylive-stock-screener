# Application
NEXT_PUBLIC_BASE_URL=https://www.ylive.ai

# Xendit Payment Gateway
# Get from: https://dashboard.xendit.co/settings/developers#api-keys
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxx
XENDIT_WEBHOOK_TOKEN=your_xendit_callback_verification_token

# WhatsApp via Fonnte (https://fonnte.com)
# Register at fonnte.com, get your device token
FONNTE_TOKEN=your_fonnte_device_token

# Email (SMTP)
# For Gmail: use App Password (not main password)
# Enable 2FA first: https://myaccount.google.com/security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password

# Cron security token
CRON_SECRET=generate_a_random_secret_here
